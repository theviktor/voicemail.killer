# ─── AssemblyAI ─────────────────────────────────────────────────────────────
# Voice Agent API key. Server-side ONLY — never ship to the browser.
# NOTE: the Voice Agent API requires the "Bearer " prefix on the auth header;
# the code adds it, so put the raw key here.
ASSEMBLYAI_API_KEY=replace_me

# ─── Twilio ─────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_me
# The number that places agent SMS alerts (must be A2P-registered to text US numbers).
TWILIO_SMS_FROM=+15555550123

# Public base URL of the SERVER service (used to build TwiML <Stream> URL and
# Twilio status callbacks). In local dev this is your ngrok/Cloudflare tunnel.
# Example: https://abcd-1234.ngrok-free.app   (no trailing slash)
PUBLIC_SERVER_URL=https://your-tunnel.example.com

# ─── Mailjet (email alerts over SMTP) ───────────────────────────────────────
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USER=your_mailjet_api_key_public
SMTP_PASS=your_mailjet_secret_key
ALERT_FROM_EMAIL=receptionist@yourdomain.com
ALERT_FROM_NAME=AI Receptionist

# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=receptionist
POSTGRES_PASSWORD=receptionist
POSTGRES_DB=receptionist
# This value is for LOCAL-NODE dev (server run via `npm run dev`, Postgres
# published on localhost:5432). docker-compose builds its own db-host URL and
# ignores this one, so you don't need to change it when switching modes.
DATABASE_URL=postgresql://receptionist:receptionist@localhost:5432/receptionist?schema=public

# ─── Ports ──────────────────────────────────────────────────────────────────
SERVER_PORT=8080
WEB_PORT=3000
# What the Next.js UI uses to reach the server's REST API (browser-reachable).
NEXT_PUBLIC_API_URL=http://localhost:8080

# ─── Demo user (seeded; later editable in the Settings UI) ───────────────────
# Set DEMO_TWILIO_NUMBER to the REAL Twilio number you'll forward calls to (E.164).
# The e2e setup points this number's voice webhook at your ngrok tunnel.
DEMO_TWILIO_NUMBER=+1XXXXXXXXXX
DEMO_USER_NAME=Alex Rivera
DEMO_COMPANY=Rivera Consulting
# Where YOU receive the message alert during the test:
DEMO_ALERT_EMAIL=you@example.com
DEMO_ALERT_PHONE=+1XXXXXXXXXX
